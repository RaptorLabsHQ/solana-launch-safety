{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "solana-launch-safety blocklist",
  "type": "object",
  "required": ["name", "description", "maintainer", "updated", "categories", "entries"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "maintainer": { "type": "string" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "categories": { "type": "object", "additionalProperties": { "type": "string" } },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["host", "category", "first_observed", "last_checked", "status", "observed", "also_listed_by", "notes"],
        "properties": {
          "host": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" },
          "category": { "type": "string", "enum": ["drainer", "impersonation", "third-party-blocklist", "lookalike-suspended", "lookalike-watch", "not-affiliated"] },
          "first_observed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "last_checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "status": { "type": "string" },
          "observed": { "type": "string", "minLength": 20 },
          "also_listed_by": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
